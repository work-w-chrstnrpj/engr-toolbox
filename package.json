{
  "name": "engr-toolbox",
  "version": "0.1.0",
  "description": "Ticket-driven engineering workflow for AI coding agents: owned skills, four roles, size tiers, an npx installer, adapters for 11 tools, and CLI gates.",
  "type": "module",
  "main": "./lib/index.mjs",
  "bin": {
    "engr-toolbox": "./bin/cli.mjs",
    "engr": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    ".agents",
    "template",
    "preset.config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node bin/cli.mjs validate",
    "sync": "node bin/cli.mjs sync --clean",
    "status": "node bin/cli.mjs status --write",
    "measure": "node bin/cli.mjs measure"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/work-w-chrstnrpj/engr-toolbox.git"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "tickets",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
